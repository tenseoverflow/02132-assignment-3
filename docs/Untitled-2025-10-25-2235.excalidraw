      "created": null
    },
    {
      "id": "code_t",
      "type": "text",
      "x": 1162,
      "y": 570,
      "width": 344.4,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1832512324,
      "version": 3,
      "versionNonce": 576382527,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795015090401,
      "link": null,
      "locked": false,
      "text": "Listing 1 (pseudo-code)\n\nfor (x from 0 to 19) {\n  for (y from 0 to 19) {\n    // Processing border pixel\n    if (x==0)  { out(x,y)=0; continue; }\n    if (y==0)  { out(x,y)=0; continue; }\n    if (x==19) { out(x,y)=0; continue; }\n    if (y==19) { out(x,y)=0; continue; }\n    // Processing inner pixel\n    if (in(x,y)==0) {\n      out(x,y)=0;            // black\n    } else {\n      if (in(x-1,y)==0 or in(x+1,y)==0 or\n          in(x,y-1)==0 or in(x,y+1)==0) {\n        out(x,y)=0;          // erode\n      } else {\n        out(x,y)=255;        // keep\n      }\n    }\n  }\n}",
      "originalText": "Listing 1 (pseudo-code)\n\nfor (x from 0 to 19) {\n  for (y from 0 to 19) {\n    // Processing border pixel\n    if (x==0)  { out(x,y)=0; continue; }\n    if (y==0)  { out(x,y)=0; continue; }\n    if (x==19) { out(x,y)=0; continue; }\n    if (y==19) { out(x,y)=0; continue; }\n    // Processing inner pixel\n    if (in(x,y)==0) {\n      out(x,y)=0;            // black\n    } else {\n      if (in(x-1,y)==0 or in(x+1,y)==0 or\n          in(x,y-1)==0 or in(x,y+1)==0) {\n        out(x,y)=0;          // erode\n      } else {\n        out(x,y)=255;        // keep\n      }\n    }\n  }\n}",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0C",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
