      "updated": 1795619128118,
      "created": 1795617686334,
      "link": null,
      "locked": false,
      "text": "border = x == 0 || x == 19 || y == 0\npixel   = dataRead != 0   (1 = white, 0 = black)\nwindow = pixel   ->  shift: pixel into w0, every other bit one place up\nw0, w19, w20, w21, w40 = Down, Right, Center, Left, Top",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "64lDXKT6kJxRMMgpZ1XPe",
      "originalText": "border = x == 0 || x == 19 || y == 0\npixel   = dataRead != 0   (1 = white, 0 = black)\nwindow = pixel   ->  shift: pixel into w0, every other bit one place up\nw0, w19, w20, w21, w40 = Down, Right, Center, Left, Top",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
