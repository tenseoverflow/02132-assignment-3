      "seed": 629048405,
      "version": 2,
      "versionNonce": 1692802705,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795014913197,
      "link": null,
      "locked": false,
      "text": "Notes:\n  DataMemory read is combinational:\n  dataRead is valid in the same\n  cycle address is set.\n  20*y = (y << 4) + (y << 2)",
      "originalText": "Notes:\n  DataMemory read is combinational:\n  dataRead is valid in the same\n  cycle address is set.\n  20*y = (y << 4) + (y << 2)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0A",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "code",
      "type": "rectangle",
      "x": 1150,
      "y": 560,
      "width": 460,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
