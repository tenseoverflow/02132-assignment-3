    {
      "id": "notes_t",
      "type": "text",
      "x": 1162,
      "y": 370,
      "width": 308,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
